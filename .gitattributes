# Keep domain list files LF on every platform — Fetcher::saveList() writes LF
# and the format must stay byte-identical across checkouts.
*.conf text eol=lf
*.php text
*.json text
*.md text
/bin/email-validator text eol=lf

# The compiled list index is generated; collapse it in diffs and stats.
/data/blocklist.php linguist-generated=true -diff
/data/metadata.json linguist-generated=true

# Keep the Composer dist archive lean: development files are not shipped.
/.claude export-ignore
/.github export-ignore
/.idea export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpunit.xml.dist export-ignore
/scripts export-ignore
/tests export-ignore
