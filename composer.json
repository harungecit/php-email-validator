{
    "name": "harungecit/php-email-validator",
    "description": "A comprehensive PHP email validation library to check format, detect disposable emails, validate MX records, role-based detection, typo suggestions, and support batch validation with configurable cache and rate limiting.",
    "type": "library",
    "keywords": [
        "email",
        "validation",
        "validator",
        "disposable",
        "email-validator",
        "mx-record",
        "php",
        "email-verification",
        "spam-protection",
        "blocklist",
        "allowlist",
        "role-based",
        "typo-suggestion",
        "smtp-verification",
        "rate-limiting",
        "configurable"
    ],
    "homepage": "https://github.com/harungecit/php-email-validator",
    "require": {
        "php": ">=8.0",
        "ext-filter": "*",
        "psr/log": "^1.0|^2.0|^3.0",
        "psr/simple-cache": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "symfony/config": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "HarunGecit\\EmailValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HarunGecit\\EmailValidator\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Harun Geçit",
            "email": "info@harungecit.com",
            "homepage": "https://harungecit.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/harungecit/php-email-validator/issues",
        "source": "https://github.com/harungecit/php-email-validator"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "suggest": {
        "ext-intl": "For internationalized domain name (IDN) support",
        "ext-redis": "For Redis cache support",
        "ext-memcached": "For Memcached cache support",
        "predis/predis": "For Redis cache without ext-redis",
        "symfony/yaml": "For YAML configuration file support",
        "illuminate/support": "To use the Laravel service provider and facade integration",
        "symfony/http-kernel": "To use the Symfony bundle integration",
        "symfony/dependency-injection": "To use the Symfony bundle integration"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HarunGecit\\EmailValidator\\Framework\\Laravel\\EmailValidatorServiceProvider"
            ],
            "aliases": {
                "EmailValidator": "HarunGecit\\EmailValidator\\Framework\\Laravel\\EmailValidatorFacade"
            }
        }
    }
}
