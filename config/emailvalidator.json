{
    "checks": {
        "format": true,
        "mx": true,
        "disposable": true,
        "role_based": false,
        "smtp": false,
        "typo_suggestion": true,
        "subaddress": false,
        "catch_all": false,
        "spoof": false
    },
    "format": {
        "mode": "filter"
    },
    "cache": {
        "driver": "memory",
        "ttl": 3600,
        "prefix": "email_validator_",
        "options": {}
    },
    "rate_limit": {
        "enabled": false,
        "max_attempts": 100,
        "decay_seconds": 60
    },
    "lists": {
        "blocklist_path": null,
        "allowlist_path": null,
        "role_based_path": null,
        "custom_blocklist": [],
        "custom_allowlist": [],
        "custom_blocklist_paths": [],
        "custom_allowlist_paths": [],
        "synced_blocklist_path": null,
        "block_subdomains": true
    },
    "sync": {
        "urls": ["https://raw.githubusercontent.com/harungecit/php-email-validator/main/data/blocklist.conf"],
        "timeout": 30
    },
    "role_based": {
        "prefixes": [
            "admin", "administrator", "info", "support", "sales", "contact",
            "noreply", "no-reply", "donotreply", "do-not-reply",
            "help", "webmaster", "postmaster", "hostmaster",
            "abuse", "billing", "marketing", "hr", "jobs", "careers",
            "press", "media", "office", "team", "hello", "enquiries",
            "enquiry", "feedback", "newsletter", "subscribe", "unsubscribe",
            "security", "privacy", "legal", "compliance", "notifications"
        ]
    },
    "typo": {
        "common_domains": [
            "gmail.com", "googlemail.com", "yahoo.com", "hotmail.com", "outlook.com",
            "icloud.com", "aol.com", "protonmail.com", "proton.me", "pm.me",
            "mail.com", "yandex.com", "zoho.com", "gmx.com", "fastmail.com",
            "live.com", "msn.com", "me.com", "mac.com",
            "hey.com", "tuta.com", "tutanota.com"
        ],
        "mappings": {}
    },
    "smtp": {
        "timeout": 10,
        "from_email": null,
        "from_domain": null
    },
    "dns": {
        "timeout": 5
    }
}
